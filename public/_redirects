# /api/* paths should 404 if no matching Function exists, not fall through to SPA.
/api/* /api/404.json 404

# Direct 404 for missing assets so they don't fall back to index.html SPA redirect.
/assets/* /404.html 404
/fonts/* /404.html 404
/icons/* /404.html 404
/*.js /404.html 404
/*.css /404.html 404
/*.ico /404.html 404
/*.png /404.html 404
/*.svg /404.html 404
/*.json /404.html 404

